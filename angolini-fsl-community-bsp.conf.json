{
    "sources": {
        "meta-freescale": {
            "git-remote": {
                "remotes": {
                    "freescale": {
                        "uri": "https://github.com/angolini/meta-freescale"
                    }
                },
                "branch": "add-fragments-distro-eula",
                "rev": "add-fragments-distro-eula"
            },
            "path": "meta-freescale"
        },
        "meta-freescale-3rdparty": {
            "git-remote": {
                "remotes": {
                    "freescale": {
                        "uri": "https://github.com/Freescale/meta-freescale-3rdparty"
                    }
                },
                "branch": "master",
                "rev": "master"
            },
            "path": "meta-freescale-3rdparty"
        },
        "meta-freescale-distro": {
            "git-remote": {
                "remotes": {
                    "freescale": {
                        "uri": "https://github.com/Freescale/meta-freescale-distro"
                    }
                },
                "branch": "master",
                "rev": "master"
            },
            "path": "meta-freescale-distro"
        },
        "bitbake": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://git.openembedded.org/bitbake"
                    }
                },
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "remotes": {
                    "oe": {
                        "uri": "https://github.com/openembedded/meta-openembedded"
                    }
                },
                "branch": "master",
                "rev": "master"
            },
            "path": "meta-openembedded"
        },
        "meta-yocto": {
            "git-remote": {
                "remotes": {
                    "yocto": {
                        "uri": "https://git.yoctoproject.org/meta-yocto"
                    }
                },
                "branch": "master",
                "rev": "master"
            },
            "path": "meta-yocto"
        },
        "openembedded-core": {
            "git-remote": {
                "remotes": {
                    "oe": {
                        "uri": "https://github.com/openembedded/openembedded-core"
                    }
                },
                "branch": "master",
                "rev": "master"
            },
            "path": "openembedded-core"
        }
    },
    "bitbake-setup": {
        "configurations": [
        {
            "bb-layers": ["openembedded-core/meta","meta-yocto/meta-poky","meta-freescale","meta-freescale-3rdparty","meta-freescale-distro"],
            "setup-dir-name": "$distro-master",
            "oe-fragments-one-of": {
                "machine": {
                    "description": "Target machines",
                    "options" : [
                        "machine/imx23evk",
                        "machine/imx28evk",
                        "machine/imx51evk",
                        "machine/imx53qsb",
                        "machine/imx6qdlsabreauto",
                        "machine/imx6qdlsabresd",
                        "machine/imx6slevk",
                        "machine/imx6sllevk",
                        "machine/imx6sxsabreauto",
                        "machine/imx6sxsabresd",
                        "machine/imx6ulevk",
                        "machine/imx6ullevk",
                        "machine/imx6ulz-14x14-evk",
                        "machine/imx7dsabresd",
                        "machine/imx7ulpevk",
                        "machine/imx8dx-mek",
                        "machine/imx8dxl-a1-ddr3l-evk",
                        "machine/imx8dxl-a1-lpddr4-evk",
                        "machine/imx8dxl-b0-ddr3l-evk",
                        "machine/imx8dxl-b0-lpddr4-evk",
                        "machine/imx8mm-ddr4-evk",
                        "machine/imx8mm-lpddr4-evk",
                        "machine/imx8mn-ddr4-evk",
                        "machine/imx8mn-lpddr4-evk",
                        "machine/imx8mnul-ddr3l-evk",
                        "machine/imx8mp-ddr4-evk",
                        "machine/imx8mp-lpddr4-evk",
                        "machine/imx8mq-evk",
                        "machine/imx8mq-lpddr4-wevk",
                        "machine/imx8qm-mek",
                        "machine/imx8qxp-mek",
                        "machine/imx8ulp-lpddr4-evk",
                        "machine/imx93-11x11-lpddr4x-evk",
                        "machine/imx93-14x14-lpddr4x-evk",
                        "machine/imx93-9x9-lpddr4-qsb",
                        "machine/imx95-19x19-verdin",
                        "machine/ls1012afrwy",
                        "machine/ls1012ardb",
                        "machine/ls1028ardb",
                        "machine/ls1043ardb",
                        "machine/ls1046afrwy",
                        "machine/ls1046ardb",
                        "machine/ls1088ardb-pb",
                        "machine/ls1088ardb",
                        "machine/ls2088ardb",
                        "machine/lx2160ardb",
                        "machine/lx2162aqds",
                        "machine/mpc8548cds",
                        "machine/p1020rdb",
                        "machine/p2020rdb",
                        "machine/p2041rdb",
                        "machine/p3041ds",
                        "machine/p4080ds",
                        "machine/p5040ds-64b",
                        "machine/p5040ds",
                        "machine/t1024rdb-64b",
                        "machine/t1024rdb",
                        "machine/t1042d4rdb-64b",
                        "machine/t1042d4rdb",
                        "machine/t2080rdb-64b",
                        "machine/t2080rdb",
                        "machine/t4240rdb-64b",
                        "machine/t4240rdb"
                    ]
                },
                "distro": {
                    "description": "FSL or FSLC Distro Base",
                    "options" : [
                        "distro/fsl",
                        "distro/fslc"
                    ]
                }
            },
            "configurations": [
            {
                "name": "accept-fsl-eula",
                "description": "Accept EULA",
                "oe-fragments": ["freescale-layer/accept-fsl-eula"]
            },
            {
                "name": "fsl-framebuffer",
                "description": "Accept EULA and configure FrameBuffer",
                "oe-fragments": [
                    "freescale-layer/accept-fsl-eula",
                    "freescale-layer/fsl-framebuffer"
                ]
            },
            {
                "name": "fsl-wayland",
                "description": "Accept EULA and configure Wayland",
                "oe-fragments": [
                    "freescale-layer/accept-fsl-eula",
                    "freescale-layer/fsl-wayland"
                ]
            },
            {
                "name": "fsl-xwayland",
                "description": "Accept EULA and configure Wayland with XWayland",
                "oe-fragments": [ "freescale-layer/accept-fsl-eula", "freescale-layer/fsl-xwayland"]
            }
            ]
        }
        ]
    },

    "version": "1.0"
}